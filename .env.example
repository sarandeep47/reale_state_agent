# Copy to .env (never commit .env) and fill in from:
# Supabase dashboard -> Project Settings -> API
#
# Only the PUBLIC values belong here. Everything prefixed with VITE_ is bundled into
# the browser JavaScript. NEVER put the service_role key or any other secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

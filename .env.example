# Copy to .env (never commit .env) and fill in from:
# Supabase dashboard -> Project Settings -> API
#
# Only the PUBLIC values belong here. Everything prefixed with VITE_ is bundled into
# the browser JavaScript. NEVER put the service_role key or any other secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n chat webhook of the "Real Estate AI - Website Agent" workflow (public URL, not a secret).
# Testing (workflow inactive): click "Execute workflow" in n8n first, then use the TEST URL:
#   https://<your-n8n-host>/webhook-test/real-estate-web/chat
# After the workflow is activated, use the production URL:
#   https://<your-n8n-host>/webhook/real-estate-web/chat
VITE_N8N_CHAT_WEBHOOK_URL=
